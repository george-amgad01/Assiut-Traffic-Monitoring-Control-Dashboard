# Normalise line endings on commit; restore LF on checkout.
# Overrides a system-wide core.autocrlf=true, which would otherwise rewrite
# this repository's LF sources to CRLF.
* text=auto

*.py      text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.html    text eol=lf
*.xml     text eol=lf
*.sumocfg text eol=lf
*.rou.xml text eol=lf
*.net.xml text eol=lf

# Generated / binary artefacts
*.pt   binary
*.png  binary
*.mp4  binary
*.ico  binary
